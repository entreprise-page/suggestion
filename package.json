{
  "name": "@entreprise-page/suggestion",
  "version": "0.0.0",
  "description": "Autocomplétion d'entreprises entreprise.page, en JavaScript natif, Vue et React",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entreprise-page/suggestion.git"
  },
  "homepage": "https://github.com/entreprise-page/suggestion#readme",
  "keywords": [
    "entreprise.page",
    "siren",
    "autocomplete",
    "suggestion",
    "vue",
    "react"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/style.css dist/",
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run format && npm run typecheck",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@entreprise-page/api-client": "^1.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  }
}
